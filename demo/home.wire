wireframe #home
    Page title="Wordey Wires"
        Text "Describe a screen in text, get a clickable wireframe. Edit any file in demo/ and the browser reloads."
        Row
            Box "Boxes"
                Text "A box can hold text and other boxes."
                Box "Like this one"
            Box "Rows"
                Text "A row shares its width between its children."
                Row
                    Box "A"
                    Box "B"
                    Box "C"
            Box "Links"
                Text "A box can link to another wireframe."
                Box "Go to organisations" to=#organisations
        Text "Data comes from CSV files, not from the markup. See the organisations pages."
